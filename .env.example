# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# URL pública da aplicação em produção, usada nos botões do Telegram.
APP_URL=https://pointcentral.fly.dev

# Timezone
TIMEZONE=America/Sao_Paulo

# State files. In production, point these to a persistent volume.
STATE_PATH=./day-state.json
STORAGE_PATH=./storage.json

# Senior point automation
# Keep the real password only in cloud/local environment variables, never in Git.
SENIOR_USERNAME=
SENIOR_PASSWORD=
SENIOR_POINT_URL=
SENIOR_REGISTER_BUTTON_TEXT=Registrar Ponto
SENIOR_AUTOMATION_TIMEOUT_MS=90000
SENIOR_BROWSER_HEADLESS=true
# Optional on Windows/local tests if Playwright browsers are not installed:
# SENIOR_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
